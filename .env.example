# Local development only. On Coolify these are supplied by the platform:
# SERVICE_PASSWORD_POSTGRES is generated and persisted for you, and
# SERVICE_FQDN_INGEST comes from the Domain configured in the UI.
#
# Never commit a real .env — .gitignore already excludes it.

# Postgres connection string used by the ingest.
DATABASE_URL=postgres://telemetry:telemetry@localhost:5432/telemetry?sslmode=disable

# Port the ingest listens on. Defaults to 8080 when unset.
PORT=8080

# Only read by docker-compose.yml for the local Postgres container.
SERVICE_PASSWORD_POSTGRES=telemetry
